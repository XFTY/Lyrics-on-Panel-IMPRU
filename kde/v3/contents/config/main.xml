<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
    <kcfgfile name=""/>

    <group name="General">
        <entry name="languageIndex" type="Int">
            <default>0</default>
        </entry>
        <entry name="showAlbumCover" type="Bool">
            <default>true</default>
        </entry>
        <entry name="enableSpotifySearch" type="Bool">
            <default>true</default>
        </entry>
        <entry name="playerMode" type="Int">
            <default>0</default>
        </entry>
        <entry name="convertToSimplified" type="Bool">
            <default>false</default>
        </entry>
        <entry name="scrollingLyrics" type="Bool">
            <default>false</default>
        </entry>
        <entry name="karaokeLyrics" type="Bool">
            <default>true</default>
        </entry>
        <entry name="karaokeFrameRate" type="Int">
            <default>60</default>
        </entry>
        <entry name="spotifyClientId" type="String">
            <default></default>
        </entry>
        <entry name="spotifyClientSecret" type="String">
            <default></default>
        </entry>
        <entry name="lyricTextSize" type="Int">
            <default>13</default>
        </entry>
        <entry name="lyricTextColor" type="Color">
            <default>#ffffff</default>
        </entry>
        <entry name="lyricTextBold" type="Bool">
            <default>true</default>
        </entry>
        <entry name="lyricTextItalic" type="Bool">
            <default>false</default>
        </entry>
        <entry name="mediaControllSpacing" type="Int"> 
            <default>10</default>
        </entry>
        <entry name="mediaControllItemSize" type="Int">
            <default>15</default>
        </entry>
        <entry name="albumCoverItemSize" type="Int">
            <default>18</default>
        </entry>
        <entry name="mediaControllItemVerticalOffset" type="Int">
            <default>1</default>
        </entry>
        <entry name="lyricTextVerticalOffset" type="Int">
            <default>0</default>
        </entry>
        <entry name="lyricTextAlignment" type="Int">
            <default>2</default>
        </entry>
        <entry name="whiteMediaControlIconsChecked" type="Bool">
            <default>false</default>
        </entry>
        <entry name="dynamicWidth" type="Bool">
            <default>true</default>
        </entry>
        <entry name="enableTextScrolling" type="Bool">
            <default>false</default>
        </entry>
        <entry name="preferedWidgetWidth" type="Int">
            <default>850</default>
        </entry>
        <entry name="hideItemWhenNoControlChecked" type="Bool">
            <default>true</default>
        </entry>
        <entry name="showNextLyric" type="Bool">
            <default>false</default>
        </entry>
        <entry name="syncOffsetMs" type="Int">
            <default>0</default>
        </entry>
        <entry name="transitionDurationMs" type="Int">
            <default>350</default>
        </entry>
        <entry name="nextLyricOpacity" type="Double">
            <default>0.4</default>
        </entry>
    </group>
</kcfg>
